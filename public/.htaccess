Options -MultiViews

# Prevent index.html from being cached so PWA always gets fresh version with analytics
<FilesMatch "^index\.html$">
  Header set Cache-Control "no-store, no-cache, must-revalidate"
  Header set Pragma "no-cache"
</FilesMatch>

RewriteEngine On

# Проверку владения доменом отдаём московскому серверу.
#
# Он не может получить сертификат на jobtoo.ru, пока имя указывает сюда:
# Let's Encrypt приходит проверять по адресу из DNS, то есть на этот хостинг.
# А поменять DNS до того, как сертификат готов, значит оставить сайт без
# https на те минуты, пока идёт выпуск.
#
# Перенаправление разрывает этот круг: проверка приходит сюда и уезжает
# туда, где её ждут. Сертификат выпускается заранее, и смена записи в DNS
# становится мгновенной — без промежутка, когда приложение не отвечает.
# Let's Encrypt переходы по ссылке выполняет, в том числе на другой адрес.
#
# Строка нужна и после переезда: сертификат продлевается каждые 60 дней, и
# если запись когда-нибудь вернут обратно, продление не встанет молча.
RewriteRule ^\.well-known/acme-challenge/(.*)$ http://147.45.184.99/.well-known/acme-challenge/$1 [R=302,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ /index.html [L]
