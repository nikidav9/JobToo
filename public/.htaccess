Options -MultiViews

# Prevent index.html from being cached so PWA always gets fresh version with analytics
<FilesMatch "^index\.html$">
  Header set Cache-Control "no-store, no-cache, must-revalidate"
  Header set Pragma "no-cache"
</FilesMatch>

RewriteEngine On

# Здесь была попытка отдавать проверку владения доменом московскому
# серверу, чтобы выпустить сертификат на jobtoo.ru заранее, до смены записи
# в DNS. Не вышло: хостинг обслуживает /.well-known/acme-challenge/ не из
# папки сайта, а подменяет своим — файл, положенный туда по FTP, отдаётся
# как 404. Ни правило отсюда, ни правило из самого каталога до него не
# достают. Оставлять их не стал: неработающая настройка с уверенным
# описанием хуже, чем её отсутствие.
#
# Сертификат выпускается иначе — см. infra/bootstrap.sh, раздел про
# сертификат на домен.

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ /index.html [L]
