# Проверку владения доменом отдаём московскому серверу.
#
# Правило есть и в корневом .htaccess, но сюда оно не достаёт: правила
# перезаписи из родительского каталога не наследуются, а в этом каталоге
# своя настройка. Снаружи это выглядело как 404 на проверку — при том что
# на любой другой несуществующий путь хостинг честно отдаёт приложение.
#
# Зачем всё это — см. корневой .htaccess: сертификат на jobtoo.ru нужно
# выпустить до того, как имя начнёт указывать на новый сервер, иначе
# переключение оставит без https и приложение, и вебхук бота.

RewriteEngine On

# Только то, чего здесь нет. Если хостинг когда-нибудь будет продлевать
# собственный сертификат, его проверка лежит файлом в этом же каталоге и
# должна отдаваться отсюда, а не уезжать в Москву.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(.*)$ http://147.45.184.99/.well-known/acme-challenge/$1 [R=302,L]
